  "logo": {
    "light": "/logo/archer-logo.svg",
    "dark": "/logo/archer-logo.svg"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#2c3576",
    "light": "#ffffff"
  },
  "navbar": {
